  <!-- Initialize Monaco & IDE Logic -->
  <script>
    let editorInstance = null;
    let diffEditorInstance = null;
    let isDiffMode = false;
    let currentFilePath = "packages/engine/src/index.ts";
    let ws = null;
    let workspacePath = "Workspace";

    // Helper: Map extension to Monaco language
    function getMonacoLanguage(filePath) {
      const ext = filePath.split('.').pop().toLowerCase();
      const map = {
        ts: 'typescript',
        tsx: 'typescript',
        js: 'javascript',
        jsx: 'javascript',
        json: 'json',
        md: 'markdown',
        html: 'html',
        css: 'css',
        py: 'python',
        rs: 'rust',
        go: 'go',
        sh: 'shell',
        bat: 'bat',
        yml: 'yaml',
        yaml: 'yaml',
        sql: 'sql'
      };
      return map[ext] || 'plaintext';
    }

    // 1. Initialize Monaco Editor
    require.config({ paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs' } });
    require(['vs/editor/editor.main'], function () {
      monaco.editor.defineTheme('flux-dark', {
        base: 'vs-dark',
        inherit: true,
        rules: [
          { token: 'comment', foreground: '64748b', fontStyle: 'italic' },
          { token: 'keyword', foreground: '00e5ff', fontStyle: 'bold' },
          { token: 'string', foreground: '10b981' },
          { token: 'identifier', foreground: 'f8fafc' },
        ],
        colors: {
          'editor.background': '#161b2a',
          'editor.foreground': '#f8fafc',
          'editor.lineHighlightBackground': '#1e2438',
          'editorCursor.foreground': '#00e5ff',
          'editorLineNumber.foreground': '#475569',
          'editorLineNumber.activeForeground': '#00e5ff',
        }
      });

      editorInstance = monaco.editor.create(document.getElementById('monaco-root'), {
        value: '// Loading FluxIDE workspace...',
        language: 'typescript',
        theme: 'flux-dark',
        fontFamily: "'JetBrains Mono', monospace",
        fontSize: 13,
        automaticLayout: true,
        minimap: { enabled: true },
        cursorBlinking: 'smooth',
        smoothScrolling: true,
      });

      // Ctrl+S / Cmd+S save command
      editorInstance.addCommand(monaco.KeyMod.CtrlCmd | monaco.KeyCode.KeyS, () => {
        saveCurrentFile();
      });

      editorInstance.onDidChangeCursorPosition((e) => {
        document.getElementById('cursorPos').textContent = `Ln ${e.position.lineNumber}, Col ${e.position.column}`;
      });

      // Initialize Diff Editor
      diffEditorInstance = monaco.editor.createDiffEditor(document.getElementById('monaco-diff-root'), {
        theme: 'flux-dark',
        fontFamily: "'JetBrains Mono', monospace",
        fontSize: 13,
        automaticLayout: true,
        readOnly: false,
      });

      // Load initial file
      openWorkspaceFile(currentFilePath);
    });

    // 2. Open workspace file into Monaco Editor
    async function openWorkspaceFile(filePath, lineNumber) {
      currentFilePath = filePath;
      const fileName = filePath.split('/').pop().split('\\\\').pop();
      document.getElementById('activeTabName').textContent = fileName;
      document.getElementById('titlebarPath').textContent = `fluxIDE APP — ${filePath}`;
      document.getElementById('aiActiveContextLabel').textContent = `@${fileName}`;

      // Update breadcrumbs
      const parts = filePath.split(/[\\\\/]/);
      const breadcrumbHtml = parts.map((p, idx) => idx === parts.length - 1 ? `<strong>${p}</strong>` : `<span>${p}</span>`).join(' &nbsp;›&nbsp; ');
      document.getElementById('breadcrumbContent').innerHTML = breadcrumbHtml;

      const lang = getMonacoLanguage(filePath);
      document.getElementById('activeLangBadge').textContent = lang.charAt(0).toUpperCase() + lang.slice(1);

      try {
        const res = await fetch('/api/fs/read?path=' + encodeURIComponent(filePath));
        if (res.ok) {
          const data = await res.json();
          if (editorInstance) {
            const oldModel = editorInstance.getModel();
            const newModel = monaco.editor.createModel(data.content, lang);
            editorInstance.setModel(newModel);
            if (oldModel) oldModel.dispose();

            if (lineNumber) {
              editorInstance.revealLineInCenter(lineNumber);
              editorInstance.setPosition({ lineNumber, column: 1 });
            }
          }
        }
      } catch (err) {
        console.warn('Failed to read file:', err);
      }

      // If in diff mode, exit back to normal code editor
      if (isDiffMode) {
        toggleDiffMode();
      }
    }

    // 3. Save current file
    async function saveCurrentFile() {
      if (!editorInstance || !currentFilePath) return;
      const content = editorInstance.getValue();
      const saveBtn = document.getElementById('saveBtn');
      const originalText = saveBtn.textContent;
      saveBtn.textContent = 'Saving...';

      try {
        const res = await fetch('/api/fs/write', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ path: currentFilePath, content })
        });
        if (res.ok) {
          saveBtn.textContent = '✅ Saved!';
          setTimeout(() => { saveBtn.textContent = originalText; }, 1500);
          loadGitStatus();
        } else {
          saveBtn.textContent = '❌ Error';
          setTimeout(() => { saveBtn.textContent = originalText; }, 2000);
        }
      } catch (err) {
        saveBtn.textContent = '❌ Error';
        setTimeout(() => { saveBtn.textContent = originalText; }, 2000);
      }
    }

    // 4. Toggle Diff Mode
    function toggleDiffMode() {
      isDiffMode = !isDiffMode;
      const normalRoot = document.getElementById('monaco-root');
      const diffRoot = document.getElementById('monaco-diff-root');
      const btn = document.getElementById('diffToggleBtn');
      const acceptBtn = document.getElementById('diffAcceptBtn');
      const rejectBtn = document.getElementById('diffRejectBtn');

      if (isDiffMode) {
        normalRoot.style.display = 'none';
        diffRoot.style.display = 'block';
        btn.textContent = '📝 Code View';
        btn.style.background = 'rgba(0,229,255,0.15)';
        btn.style.color = 'var(--accent-cyan)';
        acceptBtn.style.display = 'inline-block';
        rejectBtn.style.display = 'inline-block';

        const originalText = editorInstance ? editorInstance.getValue() : '';
        const modifiedText = originalText + '\\n// [AI Proposed Change]\\nconsole.log("FluxIDE AI Proposed Enhancement");\\n';
        const lang = getMonacoLanguage(currentFilePath);

        diffEditorInstance.setModel({
          original: monaco.editor.createModel(originalText, lang),
          modified: monaco.editor.createModel(modifiedText, lang)
        });
      } else {
        diffRoot.style.display = 'none';
        normalRoot.style.display = 'block';
        btn.textContent = '⚖️ Diff Review';
        btn.style.background = 'rgba(139,92,246,0.15)';
        btn.style.color = '#a78bfa';
        acceptBtn.style.display = 'none';
        rejectBtn.style.display = 'none';
      }
    }

    // 5. Open Git Diff for Changed File
    async function openGitDiff(filePath) {
      currentFilePath = filePath;
      try {
        const res = await fetch('/api/git/diff?path=' + encodeURIComponent(filePath));
        if (res.ok) {
          const data = await res.json();
          isDiffMode = false;
          toggleDiffMode();

          const lang = getMonacoLanguage(filePath);
          diffEditorInstance.setModel({
            original: monaco.editor.createModel(data.original || '', lang),
            modified: monaco.editor.createModel(data.modified || '', lang)
          });
        }
      } catch (err) {
        console.error('Failed to open Git diff:', err);
      }
    }

    // 6. Accept / Reject Diff Changes
    async function acceptDiffChange() {
      if (!diffEditorInstance) return;
      const modifiedModel = diffEditorInstance.getModel().modified;
      const newContent = modifiedModel.getValue();
      await fetch('/api/fs/write', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path: currentFilePath, content: newContent })
      });
      alert('✅ Change accepted and applied to ' + currentFilePath);
      toggleDiffMode();
      openWorkspaceFile(currentFilePath);
      loadGitStatus();
    }

    async function rejectDiffChange() {
      if (confirm('Revert all changes to ' + currentFilePath + ' and restore git HEAD?')) {
        await fetch('/api/git/rollback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ path: currentFilePath })
        });
        alert('↩️ Reverted changes to ' + currentFilePath);
        toggleDiffMode();
        openWorkspaceFile(currentFilePath);
        loadGitStatus();
      }
    }

    // 7. Activity Bar Switcher
    function switchActivityTab(tabName) {
      document.querySelectorAll('.activity-icon').forEach(icon => icon.classList.remove('active'));
      const activeIcon = document.getElementById('act-' + tabName);
      if (activeIcon) activeIcon.classList.add('active');

      const views = ['sidebarExplorer', 'sidebarSearch', 'sidebarGit', 'sidebarHealth', 'sidebarSettings'];
      views.forEach(v => {
        const el = document.getElementById(v);
        if (el) el.style.display = 'none';
      });

      const targetId = 'sidebar' + tabName.charAt(0).toUpperCase() + tabName.slice(1);
      const targetEl = document.getElementById(targetId);
      if (targetEl) targetEl.style.display = 'flex';

      if (tabName === 'git') loadGitStatus();
      if (tabName === 'health') runHealthScan();
    }

    // 8. Search Workspace
    async function executeSearch() {
      const query = document.getElementById('searchInput').value.trim();
      const resultsDiv = document.getElementById('searchResults');
      if (!query) return;
      resultsDiv.innerHTML = '<div style="color: var(--text-muted); padding: 4px;">Searching...</div>';

      try {
        const res = await fetch('/api/search?q=' + encodeURIComponent(query));
        const data = await res.json();
        if (!data.results || !data.results.length) {
          resultsDiv.innerHTML = '<div style="color: var(--text-muted); padding: 4px;">No matches found for "' + query + '"</div>';
          return;
        }
        resultsDiv.innerHTML = data.results.map(r => `
          <div style="padding: 6px; background: rgba(255,255,255,0.03); border-radius: 4px; cursor: pointer; border-left: 2px solid var(--accent-cyan);" onclick="openWorkspaceFile('${r.file}', ${r.line})">
            <div style="font-weight: 700; color: #fff;">${r.file}:${r.line}</div>
            <div style="color: #94a3b8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${r.text}</div>
          </div>
        `).join('');
      } catch (err) {
        resultsDiv.innerHTML = '<div style="color: var(--accent-rose);">Search error: ' + err.message + '</div>';
      }
    }

    // 9. Git Source Control Status & Commit
    async function loadGitStatus() {
      const listDiv = document.getElementById('gitFilesList');
      try {
        const res = await fetch('/api/git/status');
        const data = await res.json();
        document.getElementById('gitBranchBadge').textContent = data.branch || 'main';
        document.getElementById('sbBranch').textContent = data.branch || 'main';

        if (!data.files || !data.files.length) {
          listDiv.innerHTML = '<div style="color: var(--accent-green); padding: 6px;">✓ Clean working tree (no changes)</div>';
          return;
        }

        listDiv.innerHTML = data.files.map(f => {
          const color = f.status.includes('M') ? 'var(--accent-amber)' : f.status.includes('A') || f.status.includes('?') ? 'var(--accent-green)' : 'var(--accent-rose)';
          return `
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 4px 6px; background: rgba(255,255,255,0.03); border-radius: 4px;">
              <span style="cursor: pointer; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 170px;" onclick="openGitDiff('${f.path}')" title="${f.path}">${f.path}</span>
              <span style="font-weight: 700; color: ${color};">${f.status}</span>
            </div>
          `;
        }).join('');
      } catch (err) {
        listDiv.innerHTML = '<div style="color: var(--accent-rose);">Git status unavailable.</div>';
      }
    }

    async function commitGitChanges() {
      const msg = document.getElementById('gitCommitMsg').value.trim();
      if (!msg) {
        alert('Please enter a commit message');
        return;
      }
      try {
        const res = await fetch('/api/git/commit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: msg })
        });
        const data = await res.json();
        if (data.success) {
          document.getElementById('gitCommitMsg').value = '';
          alert('✅ Git commit succeeded!');
          loadGitStatus();
        } else {
          alert('❌ Git commit failed: ' + data.output);
        }
      } catch (err) {
        alert('Commit error: ' + err.message);
      }
    }

    // 10. Health & Diagnostics Scan
    async function runHealthScan() {
      const liveScore = document.getElementById('healthScoreDisplay');
      liveScore.textContent = 'Scanning...';
      if (!ws || ws.readyState !== WebSocket.OPEN) {
        liveScore.textContent = 'Unavailable';
        return;
      }
      ws.send(JSON.stringify({ id: 'health_' + Date.now(), type: 'health:get', payload: {} }));
      return;
      const scoreEl = document.getElementById('healthScoreDisplay');
      scoreEl.textContent = 'Scanning...';
      try {
        const res = await fetch('/api/terminal/exec', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ command: 'node -e "console.log(process.platform)"' })
        });
        setTimeout(() => {
          scoreEl.textContent = '94 / 100';
          document.getElementById('sbHealth').textContent = '94/100';
        }, 300);
      } catch {
        scoreEl.textContent = '92 / 100';
      }
    }

    // 11. Probe Ollama Status
    async function checkOllamaStatus() {
      const statusText = document.getElementById('ollamaStatusText');
      statusText.textContent = 'Probing...';
      try {
        const res = await fetch('http://127.0.0.1:11434/api/tags', { mode: 'cors' });
        if (res.ok) {
          statusText.textContent = '✓ Online';
          statusText.style.color = 'var(--accent-green)';
        } else {
          statusText.textContent = 'Offline (Start Ollama)';
          statusText.style.color = 'var(--accent-amber)';
        }
      } catch {
        statusText.textContent = 'Offline (Optional)';
        statusText.style.color = 'var(--accent-amber)';
      }
    }

    function saveVaultKeys() {
      if (!ws || ws.readyState !== WebSocket.OPEN) {
        alert('FluxIDE daemon is not connected.');
        return;
      }
      const passphrase = prompt('Create or enter the local BYOK vault passphrase. It is never stored in the renderer.');
      if (!passphrase) return;
      const keys = {
        anthropic: document.getElementById('keyAnthropic').value,
        openai: document.getElementById('keyOpenAI').value,
        gemini: document.getElementById('keyGemini').value,
      };
      ws.send(JSON.stringify({ id: 'vault_' + Date.now(), type: 'vault:configure', payload: { passphrase, keys } }));
      document.getElementById('keyAnthropic').value = '';
      document.getElementById('keyOpenAI').value = '';
      document.getElementById('keyGemini').value = '';
      return;
      alert('🔒 API Keys securely encrypted in BYOK Vault (.flux/vault.enc)');
    }

    // 12. Command Palette (Ctrl+Shift+P)
    const paletteCommands = [
      { id: 'save', label: 'File: Save Current File', action: () => saveCurrentFile() },
      { id: 'diff', label: 'View: Toggle Monaco Diff Review', action: () => toggleDiffMode() },
      { id: 'build', label: 'Terminal: Run Monorepo Build', action: () => runQuickCmd('node scripts/build.js') },
      { id: 'test', label: 'Terminal: Run Unit Test Suite', action: () => runQuickCmd('npx vitest run packages/engine/test/desktop.test.ts') },
      { id: 'git_status', label: 'Git: Refresh Source Control', action: () => { switchActivityTab('git'); loadGitStatus(); } },
      { id: 'git_commit', label: 'Git: Commit Changes', action: () => switchActivityTab('git') },
      { id: 'health', label: 'Health: Run Full Project Scan', action: () => { switchActivityTab('health'); runHealthScan(); } },
      { id: 'council', label: 'AI: Convene Engineering Council', action: () => triggerCouncilDeliberation() },
      { id: 'welcome', label: 'Help: Open Welcome & First-Run Wizard', action: () => openWelcomeModal() },
    ];

    function toggleCommandPalette() {
      const modal = document.getElementById('commandPaletteModal');
      const isVisible = modal.style.display === 'block';
      modal.style.display = isVisible ? 'none' : 'block';
      if (!isVisible) {
        document.getElementById('paletteInput').value = '';
        renderPaletteResults(paletteCommands);
        setTimeout(() => document.getElementById('paletteInput').focus(), 50);
      }
    }

    function filterPaletteCommands() {
      const query = document.getElementById('paletteInput').value.toLowerCase();
      const filtered = paletteCommands.filter(c => c.label.toLowerCase().includes(query));
      renderPaletteResults(filtered);
    }

    function renderPaletteResults(cmds) {
      const container = document.getElementById('paletteResults');
      if (!cmds.length) {
        container.innerHTML = '<div style="color: var(--text-muted); padding: 8px; font-size: 0.8rem;">No matching commands</div>';
        return;
      }
      container.innerHTML = cmds.map((c, i) => `
        <div class="palette-item ${i === 0 ? 'active' : ''}" style="padding: 8px 12px; border-radius: 4px; cursor: pointer; color: #fff; font-family: var(--font-mono); font-size: 0.8rem;" onclick="executePaletteCommand('${c.id}')">
          ⚡ ${c.label}
        </div>
      `).join('');
    }

    function executePaletteCommand(id) {
      const cmd = paletteCommands.find(c => c.id === id);
      toggleCommandPalette();
      if (cmd) cmd.action();
    }

    function handlePaletteKey(e) {
      if (e.key === 'Escape') toggleCommandPalette();
      if (e.key === 'Enter') {
        const first = document.querySelector('.palette-item');
        if (first) first.click();
      }
    }

    // 13. First-Run Welcome Wizard
    function openWelcomeModal() {
      document.getElementById('welcomeModal').style.display = 'flex';
    }

    function closeWelcomeModal() {
      document.getElementById('welcomeModal').style.display = 'none';
    }

    function selectWelcomeProvider(p) {
      if (p === 'ollama') {
        alert('Connected to Local Ollama. All intelligence runs 100% locally on your machine.');
      } else {
        switchActivityTab('settings');
      }
      closeWelcomeModal();
    }

    // 14. Connect to local fluxd WebSocket daemon
    function connectDaemon() {
      ws = new WebSocket('ws://127.0.0.1:48100');
      ws.onopen = () => {
        console.log('Connected to fluxd daemon');
        ws.send(JSON.stringify({
          id: 'session_' + Date.now(),
          type: 'session:start',
          payload: { mode: document.getElementById('aiModeSelect').value, workspacePath: workspacePath }
        }));
      };
      ws.onmessage = (event) => {
        try {
          const msg = JSON.parse(event.data);
          handleDaemonMessage(msg);
        } catch (err) {
          console.error(err);
        }
      };
      ws.onclose = () => setTimeout(connectDaemon, 3000);
    }

    function handleDaemonMessage(msg) {
      if (msg.type === 'permission:request') {
        const approved = confirm(`${msg.payload.description}\n\nScope: ${msg.payload.scope}\n\nAllow this action once?`);
        ws.send(JSON.stringify({
          id: 'permission_' + Date.now(),
          type: 'permission:respond',
          payload: { requestId: msg.payload.id, decision: approved ? 'allow_once' : 'deny' }
        }));
        return;
      }
      if (msg.type === 'poc:generated') {
        const proof = msg.payload;
        const card = document.getElementById('aiPocCard');
        card.style.display = 'block';
        const checkSummary = (proof.checks || []).map(check => `${check.name}: ${check.status}`).join(', ');
        document.getElementById('pocDetails').textContent = `Status: ${proof.verified ? 'VERIFIED' : 'NEEDS REVIEW'}\nFiles: ${(proof.filesChanged || []).join(', ') || 'none'}\nChecks: ${checkSummary || 'not run'}\nProof: ${proof.id}`;
        return;
      }
      if (msg.type === 'agent:action') {
        if (msg.payload.action === 'health_report' && msg.payload.report) {
          const score = msg.payload.report.overallScore;
          document.getElementById('healthScoreDisplay').textContent = `${score} / 100`;
          document.getElementById('sbHealth').textContent = `${score}/100`;
          return;
        }
        const feed = document.getElementById('aiFeed');
        const chip = document.createElement('div');
        chip.className = 'tool-chip';
        chip.textContent = `Action: ${msg.payload.summary || msg.payload.type || 'update'}`;
        feed.appendChild(chip);
        feed.scrollTop = feed.scrollHeight;
        return;
      }
      if (msg.type === 'stream:chunk' && msg.payload.type === 'text_delta') {
        const feed = document.getElementById('aiFeed');
        let last = feed.lastElementChild;
        if (!last || !last.classList.contains('ai-streaming')) {
          last = document.createElement('div');
          last.className = 'ai-bubble ai-streaming';
          feed.appendChild(last);
        }
        last.textContent += msg.payload.text;
        feed.scrollTop = feed.scrollHeight;
      } else if (msg.type === 'agent:action') {
        const feed = document.getElementById('aiFeed');
        const chip = document.createElement('div');
        chip.className = 'tool-chip';
        chip.textContent = `🔧 ${msg.payload.action}: ${msg.payload.tool ?? ''}`;
        feed.appendChild(chip);

        // Show PoC card if verification passed
        if (msg.payload.action === 'verification' || msg.payload.action === 'poc') {
          const card = document.getElementById('aiPocCard');
          card.style.display = 'block';
          document.getElementById('pocDetails').innerHTML = `
            Status: <strong>VERIFIED</strong><br/>
            Target: <code>${currentFilePath}</code><br/>
            PoC Hash: <code>${'poc_' + Math.random().toString(36).substring(2, 10)}</code>
          `;
        }
      }
    }

    function sendAiPrompt() {
      const input = document.getElementById('aiPromptInput');
      const text = input.value.trim();
      if (!text || !ws || ws.readyState !== WebSocket.OPEN) return;

      const feed = document.getElementById('aiFeed');
      const userBubble = document.createElement('div');
      userBubble.className = 'ai-bubble user';
      userBubble.textContent = text;
      feed.appendChild(userBubble);
      input.value = '';

      const mode = document.getElementById('aiModeSelect').value;
      ws.send(JSON.stringify({
        id: 'msg_' + Date.now(),
        type: 'user:prompt',
        payload: { content: text, mode, activeFile: currentFilePath }
      }));
    }

    function triggerCouncilDeliberation() {
      if (!ws || ws.readyState !== WebSocket.OPEN) return;
      ws.send(JSON.stringify({
        id: 'msg_' + Date.now(),
        type: 'council:deliberate',
        payload: { problem: 'Monaco Editor vs Custom Editor Architecture' }
      }));
      const feed = document.getElementById('aiFeed');
      const b = document.createElement('div');
      b.className = 'ai-bubble user';
      b.textContent = '⚖️ Convening Engineering Council (Architect, Security, Performance)...';
      feed.appendChild(b);
    }

    // 15. Workspace Tree
    async function loadWorkspaceTree() {
      const treeRoot = document.getElementById('fileTreeRoot');
      try {
        const res = await fetch('/api/workspace/tree');
        if (!res.ok) throw new Error('Failed to load tree');
        const data = await res.json();
        workspacePath = data.root || workspacePath;
        treeRoot.innerHTML = renderTreeNodes(data.tree, 0);
      } catch (err) {
        console.warn('Using fallback workspace tree:', err);
      }
    }

    function renderTreeNodes(nodes, depth) {
      if (!nodes || !nodes.length) return '';
      let html = '';
      const indent = depth * 14;

      for (const node of nodes) {
        if (node.isDirectory) {
          html += `
            <div class="tree-node folder" style="padding-left: ${indent}px;" onclick="this.classList.toggle('collapsed')">
              ▾ 📁 ${node.name}
            </div>
          `;
          if (node.children) {
            html += renderTreeNodes(node.children, depth + 1);
          }
        } else {
          html += `
            <div class="tree-node ${node.path === currentFilePath ? 'active' : ''}" style="padding-left: ${indent + 12}px;" onclick="openWorkspaceFile('${node.path}')">
              📄 ${node.name}
            </div>
          `;
        }
      }
      return html;
    }

    // 16. Terminal execution
    async function runTerminalCommand() {
      const input = document.getElementById('termCmdInput');
      const cmd = input.value.trim();
      if (!cmd) return;
      input.value = '';
      await runQuickCmd(cmd);
    }

    async function runQuickCmd(cmd) {
      const output = document.getElementById('panelOutput');
      appendTerminalLine(`PS ${workspacePath}> ${cmd}`, 'var(--accent-cyan)');
      output.scrollTop = output.scrollHeight;

      try {
        const res = await fetch('/api/terminal/exec', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ command: cmd })
        });
        const data = await res.json();
        if (data.stdout) {
          appendTerminalLine(data.stdout, '#cbd5e1');
        }
        if (data.stderr) {
          appendTerminalLine(data.stderr, 'var(--accent-rose)');
        }
        output.scrollTop = output.scrollHeight;
      } catch (err) {
        appendTerminalLine('Command error: ' + err.message, 'var(--accent-rose)');
      }
    }

    function appendTerminalLine(text, color) {
      const output = document.getElementById('panelOutput');
      const line = document.createElement('div');
      line.style.color = color;
      line.style.whiteSpace = 'pre-wrap';
      line.style.marginTop = '6px';
      line.textContent = text;
      output.appendChild(line);
    }

    function switchPanelTab(tab) {
      document.querySelectorAll('.panel-tab').forEach(t => t.classList.remove('active'));
      const activeTab = document.getElementById('tab-' + (tab === 'terminal' ? 'term' : tab === 'problems' ? 'prob' : 'out'));
      if (activeTab) activeTab.classList.add('active');
    }

    async function createNewFile() {
      const path = prompt("Enter new file path (e.g. packages/engine/src/example.ts):")?.trim();
      if (!path) return;

      try {
        const existing = await fetch('/api/fs/read?path=' + encodeURIComponent(path));
        if (existing.ok) {
          openWorkspaceFile(path);
          return;
        }
        if (existing.status !== 404) throw new Error('Could not check the requested path.');

        const created = await fetch('/api/fs/write', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ path, content: '' })
        });
        if (!created.ok) throw new Error((await created.json()).error || 'Could not create file.');

        await loadWorkspaceTree();
        openWorkspaceFile(path);
      } catch (err) {
        alert('Could not create file: ' + err.message);
      }
    }

    async function createNewFolder() {
      const path = prompt("Enter new folder name:")?.trim();
      if (!path) return;

      try {
        const response = await fetch('/api/fs/mkdir', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ path })
        });
        if (!response.ok) throw new Error((await response.json()).error || 'Could not create folder.');
        await loadWorkspaceTree();
      } catch (err) {
        alert('Could not create folder: ' + err.message);
      }
    }

    // 17. Load live quota from Supabase backend
    async function loadAiQuota() {
      try {
        const res = await fetch('/api/quota');
        if (!res.ok) return;
        const data = await res.json();
        if (!data.available) {
          document.getElementById('quotaPercentBadge').textContent = '--';
          document.getElementById('quotaUsedLabel').textContent = 'Usage unavailable';
          document.getElementById('quotaRemainingLabel').textContent = data.reason || 'Sign in to view managed quota';
          return;
        }
        const percent = Math.round((data.used_credits / data.allocated_credits) * 100);
        const percentBadge = document.getElementById('quotaPercentBadge');
        const progressBar = document.getElementById('quotaProgressBar');
        const usedLabel = document.getElementById('quotaUsedLabel');
        const remLabel = document.getElementById('quotaRemainingLabel');
        if (percentBadge) percentBadge.textContent = percent + '%';
        if (progressBar) progressBar.style.width = percent + '%';
        if (usedLabel) usedLabel.textContent = `${data.used_credits.toLocaleString()} / ${data.allocated_credits.toLocaleString()} credits`;
        if (remLabel) remLabel.textContent = `${data.remaining_credits.toLocaleString()} remaining`;
      } catch (e) {
        console.warn('Quota fetch failed:', e);
      }
    }

    // Global keyboard listener
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'P' || e.key === 'p')) {
        e.preventDefault();
        toggleCommandPalette();
      } else if (e.key === 'F1') {
        e.preventDefault();
        toggleCommandPalette();
      }
    });

    window.onload = () => {
      loadWorkspaceTree();
      connectDaemon();
      loadGitStatus();
      loadAiQuota();
    };
  </script>

</body>
</html>
