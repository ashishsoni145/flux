{
  "name": "fluxide",
  "version": "0.1.0",
  "private": true,
  "description": "FluxIDE — AI Software Engineering Platform",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "build": "node scripts/build.js",
    "build:protocol": "npm run build -w @fluxide/protocol",
    "build:gateway": "npm run build -w @fluxide/model-gateway",
    "build:engine": "npm run build -w @fluxide/engine",
    "build:cli": "npm run build -w @fluxide/cli",
    "dev:engine": "npm run dev -w @fluxide/engine",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "flux": "node packages/cli/dist/index.js",
    "fluxd": "node packages/engine/dist/index.js",
    "start": "node packages/engine/dist/index.js"
  },



  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "vitest": "^3.2.0",
    "tsup": "^8.4.0",
    "prettier": "^3.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
